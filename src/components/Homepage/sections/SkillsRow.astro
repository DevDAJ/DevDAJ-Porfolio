---
import Icons from "../../Icons.astro";
import { homepageSkills } from "../../../data/portfolio";
---

<section class="mt-10 w-full" aria-labelledby="skills-heading">
  <h2 id="skills-heading" class="sr-only">Skills</h2>
  <ul class="grid grid-cols-4 gap-3 sm:grid-cols-6" role="list">
    {
      homepageSkills.map(({ label, icon }) => (
        <li class="group flex flex-col items-center gap-2 text-center">
          <div
            class="flex h-10 w-10 items-center justify-center rounded-xl border border-border bg-canvas-elevated shadow-sm transition-all duration-300 ease-out will-change-transform motion-reduce:transition-colors motion-reduce:duration-150 group-hover:-translate-y-1 group-hover:scale-105 group-hover:border-mint/45 group-hover:bg-canvas group-hover:shadow-md motion-reduce:group-hover:translate-y-0 motion-reduce:group-hover:scale-100"
            aria-hidden="true"
          >
            <Icons type="brand" brandName={icon} />
          </div>
          <span class="max-w-22 text-[10px] font-medium leading-tight text-foreground-muted transition-colors duration-300 ease-out motion-reduce:transition-colors motion-reduce:duration-150 sm:text-xs md:text-sm group-hover:text-foreground">
            {label}
          </span>
        </li>
      ))
    }
  </ul>
</section>
