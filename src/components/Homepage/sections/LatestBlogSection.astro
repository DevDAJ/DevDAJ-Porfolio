---
import { getLatestBlogPosts } from "../../../data/blog";

const latestPosts = await getLatestBlogPosts(3);

function formatBlogDate(iso: string) {
  return new Date(`${iso}T12:00:00`).toLocaleDateString("en-GB", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
}
---

<section id="latest-blog-section" class="mx-auto max-w-3xl pb-16 sm:pb-24">
  <div class="mt-16 border-t border-border pt-16">
    <div
      class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between"
    >
      <div>
        <h2
          class="text-xl font-semibold tracking-tight text-foreground sm:text-2xl"
        >
          Latest on the blog
        </h2>
        <p class="mt-1 text-sm text-foreground-muted">
          Writing about my experiences and learnings
        </p>
      </div>
      <a
        href="/blog"
        class="inline-flex shrink-0 items-center justify-center rounded-lg bg-mint px-4 py-2 text-sm font-medium text-mint-foreground shadow-sm transition-colors duration-200 ease-out hover:bg-mint-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
      >
        View all posts
      </a>
    </div>
    <ul class="mt-8 flex flex-col gap-4">
      {
        latestPosts.map((post) => (
          <li>
            <a
              href={`/blog/${post.slug}`}
              class="group block rounded-xl border border-border bg-canvas-elevated p-4 shadow-sm transition-all duration-200 ease-out hover:border-mint/40 hover:shadow-md motion-reduce:transition-colors"
            >
              <p class="text-xs tabular-nums text-foreground-muted">
                <time datetime={post.date}>{formatBlogDate(post.date)}</time>
                <span class="mx-1.5 text-border" aria-hidden="true">
                  ·
                </span>
                <span>{post.readingMinutes} min read</span>
              </p>
              <h3 class="mt-2 text-base font-semibold text-foreground group-hover:text-mint">
                {post.title}
              </h3>
              <p class="mt-2 line-clamp-2 text-sm text-foreground-muted">
                {post.excerpt}
              </p>
              <span class="mt-3 inline-flex items-center gap-1 text-sm font-medium text-accent">
                Read post
                <span aria-hidden="true">→</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
