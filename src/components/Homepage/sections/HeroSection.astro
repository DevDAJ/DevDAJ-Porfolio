---
import SocialIconLink from "../../SocialIconLink.astro";
import Icons from "../../Icons.astro";
import { links } from "../../../data/site";
import { getAge } from "../../../utils/age";

const age = getAge();
---

<h1
  class="text-balance text-4xl font-semibold tracking-tight text-foreground sm:text-5xl"
>
  <span class="text-mint">Danial Aiman Jamil</span>
  <br />
</h1>
<h2 class="text-2xl tracking-tight text-accent font-light">
  <span class="text-foreground-muted font-semibold">{age} years old</span> | <span
    class="text-foreground-muted font-semibold">Software Engineer</span
  > | <span class="text-foreground-muted font-semibold"
    ><span class="mr-0.5 inline-block not-italic" aria-hidden="true">🇲🇾</span
    >Malaysia</span
  >
</h2>
<p class="mt-3 text-accent">
  <span class="text-foreground-muted">
    Currently a Software Engineer at
    <a
      class="font-bold dark:text-red-800 text-red-500 underline-offset-2 transition-colors duration-200 ease-out hover:text-red-600 dark:hover:text-red-700 hover:underline motion-reduce:transition-none"
      href="https://www.linkedin.com/company/kloudius-services"
    >
      Kloudius Services
    </a>
  </span>|
  <span class="text-foreground-muted">
    Focused on full-stack development
  </span>
  |
  <span class="text-foreground-muted">
    Building SaaS products for self improvement
  </span>
</p>
<div class="mt-10 flex flex-wrap items-center gap-3">
  <a
    href={links.resume}
    target="_blank"
    rel="noopener noreferrer"
    class="inline-flex items-center gap-1.5 rounded-lg border border-border bg-canvas px-5 py-2.5 text-sm font-medium text-foreground shadow-sm transition-all duration-200 ease-out hover:border-mint/40 hover:bg-canvas-elevated focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-mint motion-reduce:transition-colors"
  >
    <Icons type="material" materialIcon="open_in_new" size={5} class="shrink-0 text-mint" />
    Resume
  </a>
  <a href="/services"
    target="_blank"
    rel="noopener noreferrer"
    class="inline-flex items-center gap-1.5 rounded-lg border border-border bg-canvas px-5 py-2.5 text-sm font-medium text-foreground shadow-sm transition-all duration-200 ease-out hover:border-mint/40 hover:bg-canvas-elevated focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-mint motion-reduce:transition-colors"
  >
    <Icons type="material" materialIcon="price_change" size={5} class="shrink-0 text-mint" />
    Get a Quote
  </a>
  <div
    class="flex items-center gap-2 pl-1 sm:border-l sm:border-border sm:pl-4"
  >
    <SocialIconLink
      href={`mailto:${links.email}`}
      tooltip={`Email`}
      ariaLabel={`Email ${links.email}`}
    >
      <Icons type="material" materialIcon="email" size={5} class="shrink-0" />
    </SocialIconLink>
    <SocialIconLink
      href={links.github}
      tooltip="GitHub"
      ariaLabel="GitHub"
      external
    >
      <Icons type="brand" brandName="siGithub" size={5} class="shrink-0" />
    </SocialIconLink>
    <SocialIconLink
      href={links.linkedin}
      tooltip="LinkedIn"
      ariaLabel="LinkedIn"
      external
    >
      <Icons type="linkedin" size={5} class="shrink-0" />
    </SocialIconLink>
    <SocialIconLink
      href={links.twitter}
      tooltip="X (Twitter)"
      ariaLabel="X (Twitter)"
      external
    >
      <Icons type="brand" brandName="siX" size={5} class="shrink-0" />
    </SocialIconLink>
  </div>
</div>
