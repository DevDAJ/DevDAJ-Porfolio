---
import { HeroSection, SkillsRow, ExperienceSection, FeaturedProjectsSection, LatestBlogSection } from "./sections/index.astro";
---
<main id="hero-section" class="mx-auto max-w-3xl px-4 pt-16 sm:pt-24">
  <HeroSection />
</main>
<section id="skills-section" class="mx-auto max-w-3xl px-4">
  <SkillsRow />
</section>
<section id="experience-section" class="mx-auto max-w-3xl my-16 px-4">
  <ExperienceSection />
</section>
<section id="featured-projects-section" class="mx-auto max-w-3xl px-4">
  <FeaturedProjectsSection />
</section>
<section id="latest-blog-section" class="mx-auto max-w-3xl px-4">
  <LatestBlogSection />
</section>