    <svg
      class:list={["shrink-0 fill-current text-inherit", boxClass, className]}
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path d={LINKEDIN_PATH} />
    </svg>
  ) : (
    <span
      class:list={[
        "material-symbols-outlined inline-flex shrink-0 select-none items-center justify-center text-inherit",
        className,
      ]}
      style={{
        width: materialRem,
        height: materialRem,
        fontSize: materialRem,
        lineHeight: 1,
        fontVariationSettings: `'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' ${materialOpsz}`,
