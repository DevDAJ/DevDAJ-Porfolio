---
import type { IconSize, IconsProps } from "../types/icons";
import { BRAND_ICONS } from "../utils/brandIcons";

type Props = IconsProps;

/** LinkedIn “in” bug (simple-icons no longer ships this brand). */
const LINKEDIN_PATH =
  "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z";

/** AWS smile/arrow (not in simple-icons). */
const AWS_PATH =
  "M6.8 17.6c2.1 1.6 4.8 2.7 7.8 3.2 3 .5 6.2.6 9.3.2 3.1-.3 5.9-1.2 8.3-2.4.4-.2.8-.4 1.2-.6.4-.3.7-.5.9-.7.2-.2.3-.5.3-.8 0-.4-.2-.8-.5-1.1-.4-.3-.9-.6-1.5-.8-.6-.3-1.3-.5-2-.6-.7-.2-1.5-.3-2.2-.4-.8-.1-1.5-.2-2.2-.3-.7-.1-1.3-.2-1.8-.4-.5-.2-.9-.4-1.2-.7-.3-.3-.5-.7-.5-1.2 0-.4.1-.7.3-1 .2-.3.5-.5.8-.7.4-.2.8-.4 1.3-.5.5-.2 1-.3 1.6-.4.6-.1 1.2-.2 1.7-.3.6-.1 1.1-.2 1.5-.4.4-.2.7-.4.9-.7.2-.3.3-.7.3-1.2 0-.5-.1-1-.4-1.4-.3-.4-.7-.7-1.2-1-.5-.3-1.1-.5-1.8-.7-.7-.2-1.4-.3-2.2-.4-.8-.1-1.6-.1-2.4-.1-1.6 0-3.2.2-4.6.5-1.4.4-2.7 1-3.8 1.8-1.1.8-2 1.8-2.7 3-.7 1.2-1.1 2.6-1.1 4.1 0 1.2.3 2.3.8 3.3zM14 7.3c.7-1 1.7-1.8 2.9-2.5 1.2-.6 2.5-1 3.9-1.1 1.4-.1 2.8.1 4.1.5 1.3.4 2.4 1 3.3 1.8.9.8 1.6 1.7 2 2.8.5 1.1.7 2.3.7 3.6 0 1.6-.4 3.1-1.2 4.4-.8 1.3-1.9 2.3-3.3 3.1-1.4.8-3 1.3-4.8 1.5-1.8.2-3.6.1-5.3-.3-1.7-.4-3.2-1.1-4.5-2.1-1.3-1-2.3-2.2-3-3.6-.7-1.4-1.1-3-1.1-4.6 0-1.6.4-3.1 1.2-4.4.8-1.3 1.9-2.3 3.2-3.1 1.3-.8 2.8-1.3 4.4-1.5 1.6-.2 3.2-.1 4.8.3z";

/** Playwright rocket (not in simple-icons, simplified from official SVG). */
const PLAYWRIGHT_PATH =
  "M12 2L4 22h3l2-4h6l2 4h3L12 2zm0 5.5l2.5 7h-5L12 7.5z";

const SIZE_BOX: Record<IconSize, string> = {
  3.5: "size-3.5",
  4: "size-4",
  5: "size-5",
  6: "size-6",
  8: "size-8",
};

/**
 * Same lengths as Tailwind `size-*` (rem). Inline on material icons so
 * width, height, and font-size stay identical - avoids ligature misalignment.
 */
const MATERIAL_BOX_REM: Record<IconSize, string> = {
  3.5: "0.875rem",
  4: "1rem",
  5: "1.25rem",
  6: "1.5rem",
  8: "2rem",
};

/** Optical size for the variable font; keep close to render size (px at 16px root). */
const MATERIAL_OPSZ: Record<IconSize, number> = {
  3.5: 20,
  4: 20,
  5: 20,
  6: 24,
  8: 24,
};

const props = Astro.props;
const { size: sizeProp, class: className } = props;
const size: IconSize = sizeProp ?? 6;
const boxClass = SIZE_BOX[size];
const materialRem = MATERIAL_BOX_REM[size];
const materialOpsz = MATERIAL_OPSZ[size];

const brandIcon = props.type === "brand" ? BRAND_ICONS[props.brandName] : null;
---

{
  props.type === "brand" && brandIcon ? (
    <svg
      class:list={[
        "shrink-0 fill-current text-(--icon-c) dark:text-inherit",
        boxClass,
        className,
      ]}
      style={{ "--icon-c": `#${brandIcon.hex}` }}
      viewBox="0 0 24 24"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <path d={brandIcon.path} />
    </svg>
  ) : props.type === "aws" ? (
    <svg
      class:list={["shrink-0 fill-current text-inherit", boxClass, className]}
      viewBox="0 0 24 24"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <path d={AWS_PATH} />
    </svg>
  ) : props.type === "playwright" ? (
    <svg
      class:list={["shrink-0 fill-current text-inherit", boxClass, className]}
      viewBox="0 0 24 24"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <path d={PLAYWRIGHT_PATH} />
    </svg>
  ) : props.type === "linkedin" ? (
    <svg
      class:list={["shrink-0 fill-current text-inherit", boxClass, className]}
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path d={LINKEDIN_PATH} />
    </svg>
  ) : (
    <span
      class:list={[
        "material-symbols-outlined inline-flex shrink-0 select-none items-center justify-center text-inherit",
        className,
      ]}
      style={{
        width: materialRem,
        height: materialRem,
        fontSize: materialRem,
        lineHeight: 1,
        fontVariationSettings: `'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' ${materialOpsz}`,
      }}
      aria-hidden="true"
    >
      {"materialIcon" in props ? props.materialIcon : ""}
    </span>
  )
}
