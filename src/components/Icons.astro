---
import type { IconSize, IconsProps } from "../types/icons";
import { BRAND_ICONS } from "../utils/brandIcons";

type Props = IconsProps;

/** LinkedIn “in” bug (simple-icons no longer ships this brand). */
const LINKEDIN_PATH =
  "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z";

/** Playwright rocket (not in simple-icons, simplified from official SVG). */const SIZE_BOX: Record<IconSize, string> = {
  3.5: "size-3.5",
  4: "size-4",
  5: "size-5",
  6: "size-6",
  8: "size-8",
};

/**
 * Same lengths as Tailwind `size-*` (rem). Inline on material icons so
 * width, height, and font-size stay identical - avoids ligature misalignment.
 */
const MATERIAL_BOX_REM: Record<IconSize, string> = {
  3.5: "0.875rem",
  4: "1rem",
  5: "1.25rem",
  6: "1.5rem",
  8: "2rem",
};

/** Optical size for the variable font; keep close to render size (px at 16px root). */
const MATERIAL_OPSZ: Record<IconSize, number> = {
  3.5: 20,
  4: 20,
  5: 20,
  6: 24,
  8: 24,
};

const props = Astro.props;
const { size: sizeProp, class: className } = props;
const size: IconSize = sizeProp ?? 6;
const boxClass = SIZE_BOX[size];
const materialRem = MATERIAL_BOX_REM[size];
const materialOpsz = MATERIAL_OPSZ[size];

const brandIcon = props.type === "brand" ? BRAND_ICONS[props.brandName] : null;
---

{
  props.type === "brand" && brandIcon ? (
    <svg
      class:list={[
        "shrink-0 fill-current text-(--icon-c) dark:text-inherit",
        boxClass,
        className,
      ]}
      style={{ "--icon-c": `#${brandIcon.hex}` }}
      viewBox="0 0 24 24"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <path d={brandIcon.path} />
    </svg>
  ) : props.type === "aws" ? (
    <svg
      class:list={["shrink-0 fill-current text-[#252F3E] dark:text-white", boxClass, className]}
      viewBox="0 0 304 182"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
