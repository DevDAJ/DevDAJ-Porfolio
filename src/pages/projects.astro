---
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects } from "../data/portfolio";
import { collectProjectFilterTags, projectTagsFlat } from "../utils/projectTags";
import {
  projectTagChipActiveClass,
  projectTagChipInactiveClass,
} from "../utils/initProjectTagFilter";

const filterTags = collectProjectFilterTags(projects);
const firstProjectImageIndex = projects.findIndex((p) => p.cardImage);
---

<Layout>
  <section class="mx-auto max-w-3xl px-4 py-16 sm:py-20">
    <h1
      class="text-3xl font-semibold tracking-tight text-foreground sm:text-4xl"
    >
      Projects
    </h1>
    <p class="mt-3 text-foreground-muted">
      List of all projects I've worked on. Will be updated with more projects as
      I work on them.
    </p>

    <div
      id="project-tag-filters"
      class="mt-8 flex min-w-0 flex-wrap gap-2 overflow-x-auto pb-1 [-webkit-overflow-scrolling:touch]"
      role="toolbar"
      aria-label="Filter projects by tag"
    >
      <button
        type="button"
        data-tag-filter=""
        aria-pressed="true"
        class={projectTagChipActiveClass}
      >
        All
      </button>
      {
        filterTags.map((t) => (
          <button
            type="button"
            data-tag-filter={t}
            aria-pressed="false"
            class={projectTagChipInactiveClass}
          >
            {t}
          </button>
        ))
      }
    </div>

    <ul
      id="projects-bento-grid"
      class="mt-8 grid grid-cols-12 gap-4 auto-rows-min md:auto-rows-auto"
      aria-live="polite"
    >
      {
        projects.map((p, i) => (
          <li
            class="col-span-12 min-w-0"
            data-project-tags={projectTagsFlat(p).join(",")}
            data-has-image={p.cardImage ? "true" : "false"}
          >
            <ProjectCard
              project={p}
              heading="h2"
              cardImagePriority={i === firstProjectImageIndex}
            />
          </li>
        ))
      }
    </ul>
  </section>
</Layout>

<script>
  import { initProjectTagFilter } from "../utils/initProjectTagFilter";

  initProjectTagFilter();
  document.addEventListener("astro:page-load", initProjectTagFilter);
</script>
